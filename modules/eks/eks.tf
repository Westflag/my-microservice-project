resource "aws_eks_cluster" "this" { name = var.cluster_name role_arn = "arn:aws:iam::123456789012:role/dummy" version = var.cluster_version vpc_config { subnet_ids = var.subnet_ids endpoint_private_access = true endpoint_public_access = true } }
resource "aws_eks_node_group" "this" { cluster_name = aws_eks_cluster.this.name node_group_name = var.node_group_name node_role_arn = "arn:aws:iam::123456789012:role/dummy" subnet_ids = var.subnet_ids instance_types = var.instance_types scaling_config { desired_size = var.desired_size max_size = var.max_size min_size = var.min_size } }
